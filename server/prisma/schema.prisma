generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  username       String       @unique
  passwordDigest String

  experiences    Experience[]
  reviews        Review[]
  trips          Trip[]
  interests      Interest[]
  settings       UserSettings?
}

model UserSettings {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredFeedSort  String   @default("newest") // "newest" | "highestRated" | "recommended"
  lastUpdated        DateTime @updatedAt

  @@index([userId])
}

model Experience {
  id              Int       @id @default(autoincrement())

  createdBy       Int
  user            User      @relation(fields: [createdBy], references: [id])

  title           String
  description     String
  descriptionEdit String?

  dateCreated     DateTime  @default(now())
  lastUpdated     DateTime  @updatedAt

  latitude        Float
  longitude       Float

  country         String?
  adminRegion     String?
  city            String?
  street          String?
  postalCode      String?

  thumbnail       String?
  avgRating       Float?

  keywords        String[]

  categoryId      Int?
  category        Category? @relation(fields: [categoryId], references: [id])

  experienceTags  ExperienceTag[]
  trips           TripExperience[]
  reviews         Review[]

  @@index([createdBy])
  @@index([categoryId])
}

model Review {
  id            Int      @id @default(autoincrement())
  rating        Int
  reviewText    String
  dateCreated   DateTime @default(now())

  experienceId  Int
  experience    Experience @relation(fields: [experienceId], references: [id])

  userId        Int
  user          User @relation(fields: [userId], references: [id])

  @@index([experienceId])
  @@index([userId])
}

model Trip {
  id            Int      @id @default(autoincrement())

  createdBy     Int
  user          User     @relation(fields: [createdBy], references: [id])

  title         String
  description   String?

  dateCreated   DateTime @default(now())
  lastUpdated   DateTime @updatedAt

  experiences   TripExperience[]

  @@index([createdBy])
}

model TripExperience {
  tripId       Int
  experienceId Int

  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([tripId, experienceId])
  @@index([experienceId])
}

model Category {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  label       String

  tags        Tag[]
  experiences Experience[]
}

model Tag {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  label       String

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  experienceTags ExperienceTag[]
}

model ExperienceTag {
  experienceId Int
  tagId        Int

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([experienceId, tagId])
  @@index([tagId])
  @@index([experienceId])
}

model Interest {
  id          Int      @id @default(autoincrement())
  createdBy   Int
  user        User     @relation(fields: [createdBy], references: [id])

  name        String
  description String?

  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt

  @@index([createdBy])
  @@index([dateCreated])
}