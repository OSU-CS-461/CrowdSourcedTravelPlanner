generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  passwordDigest String
  username       String        @unique
  experiences    Experience[]
  images         Image[]
  interests      Interest[]
  reviews        Review[]
  trips          Trip[]
  settings       UserSettings?
  likedExperiences UserLikedExperience[]
  likedTags        UserLikedTag[]
  likedTrips       UserLikedTrip[]
}

model UserSettings {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  preferredFeedSort   String   @default("newest")
  /// UI appearance: light (day) or dark (night).
  themePreference     String   @default("light")
  lastUpdated         DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Experience {
  id              Int              @id @default(autoincrement())
  createdBy       Int
  title           String
  description     String
  descriptionEdit String?
  dateCreated     DateTime         @default(now())
  lastUpdated     DateTime         @updatedAt
  country         String?
  adminRegion     String?
  city            String?
  street          String?
  postalCode      String?
  latitude        Float
  longitude       Float
  thumbnail       String?
  avgRating       Float?
  reviewCount     Int              @default(0)
  mostRecentReviewAt DateTime?
  categoryId      Int?
  keywords        String[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  user            User             @relation(fields: [createdBy], references: [id])
  experienceTags  ExperienceTag[]
  images          Image[]
  reviews         Review[]
  likedByUsers    UserLikedExperience[]
  trips           TripExperience[]

  @@index([createdBy])
  @@index([categoryId])
  @@index([mostRecentReviewAt])
  @@index([mostRecentReviewAt, avgRating])
}

model Review {
  id           Int        @id @default(autoincrement())
  rating       Int
  reviewText   String
  dateCreated  DateTime   @default(now())
  experienceId Int
  userId       Int
  experience   Experience @relation(fields: [experienceId], references: [id])
  images       Image[]
  user         User       @relation(fields: [userId], references: [id])

  @@index([experienceId])
  @@index([userId])
}

model Image {
  id               Int        @id @default(autoincrement())
  createdBy        Int
  experienceId     Int
  reviewId         Int?
  storageKey       String     @unique
  originalFilename String
  mimeType         String?
  fileSizeBytes    Int?
  url              String
  altText          String?
  caption          String?
  sortOrder        Int        @default(0)
  dateCreated      DateTime   @default(now())
  lastUpdated      DateTime   @updatedAt
  experience       Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  review           Review?    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy])
  @@index([experienceId])
  @@index([reviewId])
  @@index([experienceId, sortOrder])
  @@index([reviewId, sortOrder])
}

model Trip {
  id          Int              @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  dateCreated DateTime         @default(now())
  lastUpdated DateTime         @updatedAt
  createdBy   Int
  user        User             @relation(fields: [createdBy], references: [id])
  experiences TripExperience[]
  likedByUsers UserLikedTrip[]

  @@index([createdBy])
}

model TripExperience {
  tripId       Int
  experienceId Int
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([tripId, experienceId])
  @@index([experienceId])
}

model Category {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  label       String
  experiences Experience[]
  tags        Tag[]
}

model Tag {
  id             Int             @id @default(autoincrement())
  slug           String          @unique
  label          String
  categoryId     Int
  experienceTags ExperienceTag[]
  likedByUsers     UserLikedTag[]
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ExperienceTag {
  experienceId Int
  tagId        Int
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([experienceId, tagId])
  @@index([tagId])
  @@index([experienceId])
}

model Interest {
  id          Int      @id @default(autoincrement())
  createdBy   Int
  name        String
  description String?
  dateCreated DateTime @default(now())
  lastUpdated DateTime @updatedAt
  user        User     @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([dateCreated])
}

model UserLikedExperience {
  userId         Int
  experienceId   Int
  dateCreated    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([userId, experienceId])
  @@index([experienceId])
  @@index([userId, dateCreated])
}

model UserLikedTag {
  userId      Int
  tagId       Int
  dateCreated DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
  @@index([userId, dateCreated])
}

model UserLikedTrip {
  userId      Int
  tripId      Int
  dateCreated DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([userId, tripId])
  @@index([tripId])
  @@index([userId, dateCreated])
}
