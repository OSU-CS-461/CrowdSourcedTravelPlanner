# Copy to server/.env — full steps: ../WINDOWS_SETUP.md
#
# After: cd server && npx prisma dev  (wait for success, press "h"), paste DATABASE_URL here:
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=your_api_key_here"
JWT_SECRET="paste-your-generated-jwt-secret-here"
NODE_ENV=development

# Optional: Docker Postgres example at repo root docker-compose.yml (host port 5433).
