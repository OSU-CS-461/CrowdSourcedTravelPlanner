# Copy to server/.env — full steps: ../WINDOWS_SETUP.md
#
# 1) Start Prisma dev:  cd server && npx prisma dev  (keep it running; default uses ports 51213-51215)
# 2) For Prisma *Client* at runtime, use a direct Postgres URL (prisma+postgres is for some CLI flows only).
#    Example when default prisma dev is up:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51214/postgres?sslmode=disable&pgbouncer=true"
JWT_SECRET="paste-your-generated-jwt-secret-here"
NODE_ENV=development

# Optional: Docker Postgres at repo root docker-compose.yml (host port 5433).
